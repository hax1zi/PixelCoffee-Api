// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Table {
  id          String  @id @default(uuid())
  tableNumber Int     @unique
  orders      Order[]
}

model Coffee {
  id          String      @id @default(uuid())
  SKU         String      @unique
  name        String
  price       Decimal
  image       String
  description String
  orders      OrderItem[]
}

model Order {
  id        String      @id @default(uuid())
  tableId   String
  createdAt DateTime    @default(now())
  table     Table       @relation(fields: [tableId], references: [id])
  items     OrderItem[]
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  coffeeSKU String
  quantity  Int
  order     Order  @relation(fields: [orderId], references: [id])
  coffee    Coffee @relation(fields: [coffeeSKU], references: [SKU])

  @@unique([orderId, coffeeSKU])
}
